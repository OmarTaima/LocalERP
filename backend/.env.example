NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/erp
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1h
REFRESH_EXPIRES_IN_DAYS=30
CORS_ORIGIN=*
SUPERADMIN_EMAIL=superadmin@localerp.com
SUPERADMIN_PASSWORD=SuperAdmin!ChangeMe2026
# Cloudflare R2 (S3-compatible) — used for avatar/logo/product image storage (replaces local uploads/)
# Create an R2 API token with "Object Read & Write" permission at https://dash.cloudflare.com/profile/api-tokens
# R2_ACCOUNT_ID is the Cloudflare account ID; R2_PUBLIC_BASE_URL is the bucket's public base URL (e.g. https://pub-xxxx.r2.dev)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=