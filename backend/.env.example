NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/erp
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1h
REFRESH_EXPIRES_IN_DAYS=30
CORS_ORIGIN=*
SUPERADMIN_EMAIL=superadmin@localerp.com
SUPERADMIN_PASSWORD=SuperAdmin!ChangeMe2026
# Cloudinary (Programmable Media) — used ONLY for server-side deletion of replaced images
# (avatars, logos, product photos). Get the three values from the Cloudinary dashboard:
# Programmable Media -> Settings -> API Keys ("View API Keys").
# Uploads are not created by the backend anymore: the browser posts files directly to
# https://api.cloudinary.com/v1_1/<cloud_name>/auto/upload using the UNSIGNED upload preset
# "ml_default" and stores the returned secure_url. No signature is ever generated here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=